# Copy to .env beside docker-compose.production.yml and replace every value.
POSTGRES_USER=vajra
POSTGRES_DB=vajra
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Generate with: backend/.venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAJRA_DATA_ENCRYPTION_KEY=replace-with-a-fernet-key
VAJRA_TRANSACTION_RETENTION_DAYS=90
VAJRA_CORS_ORIGINS=["https://vajra.example.com"]
VAJRA_AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
