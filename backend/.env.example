# Copy to .env to override defaults. All variables are prefixed VAJRA_.
VAJRA_DATABASE_URL=sqlite:///./vajra.db
VAJRA_DEFAULT_RATE_LIMIT_RPS=1.0
VAJRA_HTTP_TIMEOUT_SECONDS=8.0
# Katana crawling is intentionally opt-in. Install Katana locally before enabling.
VAJRA_KATANA_ENABLED=false
VAJRA_KATANA_EXECUTABLE=katana
VAJRA_KATANA_DEPTH=2
# Public metadata performs bounded GETs for robots.txt and sitemap documents.
VAJRA_PUBLIC_METADATA_ENABLED=true
VAJRA_PUBLIC_METADATA_MAX_RESPONSE_BYTES=2097152
VAJRA_PUBLIC_METADATA_MAX_DOCUMENTS_PER_HOST=10
VAJRA_API_SPEC_DISCOVERY_ENABLED=true
# Hunt Copilot. Keep keys server-side; never prefix them with VITE_.
VAJRA_AI_PROVIDER=auto
VAJRA_GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=
# Optional fallback provider:
ANTHROPIC_API_KEY=
# Evidence ZIP exports are bounded by uncompressed source size and attachment count.
VAJRA_MAX_EVIDENCE_EXPORT_BYTES=104857600
VAJRA_MAX_EVIDENCE_EXPORT_ATTACHMENTS=100
VAJRA_MAX_EVIDENCE_VERIFY_UPLOAD_BYTES=115343360
VAJRA_MAX_EVIDENCE_VERIFY_UNCOMPRESSED_BYTES=131072000
