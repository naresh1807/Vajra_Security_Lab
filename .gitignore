# Secrets - never commit a real .env. The *.example templates ARE tracked.
.env
.env.*
!.env.example
!.env.production.example
!backend/.env.example

# Python / backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/*.db
backend/.vajra-data.key
backend/uploads/
*.pyc

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo

# Desktop (Electron) build artifacts
desktop/node_modules/
desktop/out/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
