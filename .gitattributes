# Normalize line endings: LF in the repo and working tree on every OS.
# The CI runners and Docker images are Linux; keep shell scripts and
# configs LF regardless of the contributor's core.autocrlf setting.
* text=auto eol=lf

# Binary / generated - never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.db binary
*.key binary
frontend/package-lock.json -diff
